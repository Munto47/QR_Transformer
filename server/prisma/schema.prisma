generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ProcessingLog {
  id           String   @id @default(cuid())
  rawContent   String
  extractedId  String
  finalContent String
  createdAt    DateTime @default(now())

  imageBytes   Bytes
  mimeType     String
  originalName String?
  sizeBytes    Int
}

model ActivityQr {
  id           String    @id @default(cuid())
  activityName String
  activityAt   DateTime
  /** 学校（五选一），与客户端常量一致 */
  school       String    @default("其他高校")
  /** 活动签到开始时间，选填 */
  signInAt     DateTime?
  createdAt    DateTime  @default(now())

  imageBytes   Bytes
  mimeType     String
  originalName String?
  sizeBytes    Int
}
