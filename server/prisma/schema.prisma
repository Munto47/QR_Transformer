generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ProcessingLog {
  id           String   @id @default(cuid())
  rawContent   String
  extractedId  String
  finalContent String
  createdAt    DateTime @default(now())

  imageBytes   Bytes
  mimeType     String
  originalName String?
  sizeBytes    Int
}
