# ============================================================
# 生产环境变量模板（复制为 .env 并填写真实值）
# 此文件可提交 Git；.env 本身绝不提交
# ============================================================

# PostgreSQL 连接串（指向服务器上已有的数据库，勿改库名/用户，以保留原数据）
DATABASE_URL="postgresql://qruser:your_password@127.0.0.1:5434/qrdb"

# 管理员登录密码
ADMIN_PASSWORD="your_strong_password"

# JWT 签名密钥（生产环境请换成随机长字符串）
JWT_SECRET="your_random_jwt_secret"

# 服务监听端口（默认 3100）
# PORT=3100
